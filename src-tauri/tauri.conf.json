{
  "productName": "词稿",
  "version": "0.1.1",
  "identifier": "cn.promptdraft.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "词稿",
        "width": 1260,
        "height": 820,
        "minWidth": 480,
        "minHeight": 570,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQUIxREU3NzlEQkMzRTcKUldUbnc5dDU1eDJyOG0rc0xLZXh0UE1xNkxraEJ5MndTa2VkQkhtZUxRbFdOaWRPMVZ0V0JOWHAK",
      "endpoints": [
        "https://gitee.com/liuliang6666/prompt-draft-releases/raw/master/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
